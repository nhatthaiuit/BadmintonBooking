<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    tools:context=".HomeActivity">

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/primary"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Badminton Booking"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/imgHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="History"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#1976D2"
                    android:paddingHorizontal="14dp"
                    android:layout_marginEnd="10dp" />

                <Button

                    android:id="@+id/imgLogout"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Logout"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:backgroundTint="#D32F2F"
                    android:paddingHorizontal="14dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvSelectDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_cell_empty"
                android:textColor="@color/primary_dark"
                android:text="21/05/2026"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:scrollbars="none">

                <RadioGroup
                    android:id="@+id/radioGroupBranches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbBranch1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Go Vap"
                        android:textColor="@color/white"
                        android:buttonTint="@color/white"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbBranch2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Binh Thanh"
                        android:textColor="@color/white"
                        android:buttonTint="@color/white"
                        android:layout_marginStart="12dp" />

                    <RadioButton
                        android:id="@+id/rbBranch3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dist 1"
                        android:textColor="@color/white"
                        android:buttonTint="@color/white"
                        android:layout_marginStart="12dp" />

                </RadioGroup>
            </HorizontalScrollView>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/bg_cell_empty" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Empty"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_cell_booked" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Booked"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_cell_selected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Selected"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/matrixScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="8dp"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout"
        app:layout_constraintBottom_toTopOf="@+id/bannerCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TableLayout
                android:id="@+id/tableLayoutMatrix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent" />

        </HorizontalScrollView>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBarLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="@color/primary"
        app:layout_constraintTop_toTopOf="@+id/matrixScrollView"
        app:layout_constraintBottom_toBottomOf="@+id/matrixScrollView"
        app:layout_constraintStart_toStartOf="@+id/matrixScrollView"
        app:layout_constraintEnd_toEndOf="@+id/matrixScrollView" />

    <FrameLayout
        android:id="@+id/bannerCard"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_cell_empty"
        app:layout_constraintTop_toBottomOf="@+id/matrixScrollView"
        app:layout_constraintBottom_toTopOf="@+id/availableInfoBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ViewFlipper
            android:id="@+id/viewFlipperBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="2800"
            android:inAnimation="@android:anim/fade_in"
            android:outAnimation="@android:anim/fade_out">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/court_banner_1" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/court_banner_2" />

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/court_banner_3" />

        </ViewFlipper>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="bottom"
            android:padding="16dp"
            android:background="#66000000">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Premium Indoor Courts"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Book your favorite court instantly"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/availableInfoBar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:text="Available slots: 119/119"
        android:textColor="@color/primary_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_cell_empty"
        app:layout_constraintTop_toBottomOf="@+id/bannerCard"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:background="@color/primary"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTotalInfo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Selected: 0 hours\nTotal: 0 VND"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textColor="@color/primary"
            app:backgroundTint="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>